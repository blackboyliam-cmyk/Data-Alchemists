# Supabase Postgres (recommended)
# Dashboard → Project Settings → Database → Connection string → URI
# Paste the URI as-is. The app converts postgres:// to postgresql+psycopg:// and adds SSL.
#
# Prefer Session pooler (port 5432) or Direct (db.<project-ref>.supabase.co:5432)
# for create_all / first startup. Transaction pooler is port 6543.
SUPABASE_DB_URL=
# Optional instead of the full URI:
# SUPABASE_PROJECT_REF=abcdefghijklmnop
# SUPABASE_DB_PASSWORD=your-database-password
#
# DATABASE_URL is used if SUPABASE_DB_URL is empty.
# Leave both empty only for a local SQLite fallback.
DATABASE_URL=

SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Government of India Open Government Data (data.gov.in) — AGMARKNET daily prices
# Register at https://data.gov.in and create an API key. Do not invent keys.
DATA_GOV_IN_API_BASE=https://api.data.gov.in/resource
DATA_GOV_IN_API_KEY=
# Official AGMARKNET "Current Daily Price of Various Commodities" resource
DATA_GOV_IN_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
# Optional second resource (variety-wise daily prices) if the primary fails
DATA_GOV_IN_FALLBACK_RESOURCE_ID=35985678-0d79-46b4-9ed6-6f13308a1d24

# Limit how many mandi records to pull per scheduled run (pagination still used)
MANDI_SYNC_MAX_RECORDS=2000
MANDI_SYNC_STATES=Maharashtra,Karnataka,Madhya Pradesh,Gujarat,Rajasthan

# Weather — Open-Meteo (documented public API, no key required)
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_GEOCODE_URL=https://geocoding-api.open-meteo.com/v1/search

# Optional OpenWeatherMap (leave blank to use Open-Meteo)
OPENWEATHER_API_KEY=
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# Road distance — public OSRM. If unreachable, haversine estimate is used and labelled.
OSRM_BASE_URL=https://router.project-osrm.org

SYNC_INTERVAL_MINUTES=180
WEATHER_SYNC_INTERVAL_MINUTES=60

ADMIN_EMAIL=admin@farmdss.local
ADMIN_PASSWORD=ChangeMeAdmin1!
DEMO_FARMER_EMAIL=farmer@farmdss.local
DEMO_FARMER_PASSWORD=ChangeMeFarmer1!

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Add your Vercel URL here, e.g. https://data-alchemists.vercel.app
